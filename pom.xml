<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ordering follows https://maven.apache.org/developers/conventions/code.html#POM_Code_Convention -->

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                                 PARENT                                  -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Inheritance -->
    <parent>
        <groupId>wtf.metio.maven</groupId>
        <artifactId>maven-parent</artifactId>
        <version>2026.8.1043609</version>
    </parent>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               COORDINATES                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Maven_Coordinates -->
    <groupId>wtf.metio.yosql</groupId>
    <artifactId>yosql</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               INFORMATION                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#More_Project_Information -->
    <name>YoSQL</name>
    <description>YoSQL: write more SQL</description>
    <url>https://yosql.projects.metio.wtf/</url>
    <inceptionYear>2017</inceptionYear>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                                    SCM                                  -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#SCM -->
    <scm>
        <connection>scm:git:git@github.com:metio/yosql.git</connection>
        <developerConnection>scm:git:git@github.com:metio/yosql.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/metio/yosql</url>
    </scm>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                             ISSUE MANAGEMENT                            -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Issue_Management -->
    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/metio/yosql/issues</url>
    </issueManagement>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                                PROPERTIES                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Properties -->
    <properties>
        <!-- A fixed value keeps jar entry timestamps out of the artifact bytes, so
             two builds of the same source produce byte-identical jars. The release
             overrides it with the timestamp of the release commit. Must be ISO-8601:
             a bare number is read as seconds since the epoch, which lands outside the
             1980-2099 range the reproducible-build plugins accept. -->
        <project.build.outputTimestamp>2024-01-01T00:00:00Z</project.build.outputTimestamp>

        <!-- The baseline for everything: the JDK this builds on, the bytecode it
             emits, and the oldest JDK generated code has to run on. -->
        <global.jdkVersion>25</global.jdkVersion>

        <!-- Since JDK 23 javac ignores annotation processors it finds on the class
             path unless asked to run them, and it says nothing when it skips them.
             This build is largely written by processors — Immutables and Dagger —
             so without this the generated types simply are not there, and the first
             sign of it is a compile error about a class nobody wrote. -->
        <maven.compiler.proc>full</maven.compiler.proc>

        <!-- Dependency versions. The parent POM manages plugins but no libraries,
             so every third-party version a module uses is declared here and
             maintained by Renovate. -->
        <version.ant>1.10.17</version.ant>
        <version.cal10n>0.8.1</version.cal10n>
        <version.dagger>2.60.1</version.dagger>
        <version.h2>2.4.240</version.h2>
        <version.hikaricp>7.1.0</version.hikaricp>
        <version.immutables>2.12.2</version.immutables>
        <version.jackson>2.22.1</version.jackson>
        <version.javaparser>3.28.2</version.javaparser>
        <version.javapoet>0.18.0</version.javapoet>
        <version.javax-inject>1</version.javax-inject>
        <version.jmh>1.37</version.jmh>
        <version.jspecify>1.0.1</version.jspecify>
        <version.junit>6.1.2</version.junit>
        <version.kotlin>2.4.10</version.kotlin>
        <version.log4j>2.26.1</version.log4j>
        <version.logback>1.6.1</version.logback>
        <version.maven>3.9.16</version.maven>
        <version.maven-plugin-tools>3.15.2</version.maven-plugin-tools>
        <version.maven-shared-utils>3.4.2</version.maven-shared-utils>
        <version.mustache>0.9.14</version.mustache>
        <version.picocli>4.7.7</version.picocli>
        <version.plexus-build-api>1.2.0</version.plexus-build-api>
        <version.plexus-sec-dispatcher>4.1.0</version.plexus-sec-dispatcher>
        <version.postgresql>42.7.13</version.postgresql>
        <version.sisu>1.1.0</version.sisu>
        <version.slf4j>2.0.18</version.slf4j>
        <version.tinylog>2.7.0</version.tinylog>

        <!-- Plugin versions the parent POM does not manage. -->
        <version.m-plugin-p>3.15.2</version.m-plugin-p>
    </properties>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                          DISTRIBUTION MANAGEMENT                        -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Distribution_Management -->
    <distributionManagement>
        <site>
            <id>metio</id>
            <name>official website</name>
            <url>https://yosql.projects.metio.wtf</url>
        </site>
    </distributionManagement>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                                  MODULES                                -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Aggregation -->
    <modules>
        <module>yosql-internals</module>
        <module>yosql-models</module>
        <module>yosql-codegen</module>
        <module>yosql-tooling</module>
        <module>yosql-examples</module>
        <module>yosql-benchmarks</module>
        <module>docs</module>
    </modules>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
