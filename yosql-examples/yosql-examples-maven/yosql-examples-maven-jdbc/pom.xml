<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ordering follows https://maven.apache.org/developers/conventions/code.html#POM_Code_Convention -->

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                                 PARENT                                  -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Inheritance -->
    <parent>
        <groupId>wtf.metio.yosql.examples.maven</groupId>
        <artifactId>yosql-examples-maven</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               COORDINATES                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Maven_Coordinates -->
    <artifactId>yosql-examples-maven-jdbc</artifactId>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               INFORMATION                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#More_Project_Information -->
    <name>YoSQL :: Examples :: Maven :: JDBC</name>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               DEPENDENCIES                              -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Dependencies -->
    <dependencies>
        <dependency>
            <groupId>wtf.metio.yosql.examples</groupId>
            <artifactId>yosql-examples-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>wtf.metio.yosql.tooling</groupId>
                <artifactId>yosql-tooling-maven</artifactId>
                <configuration>
                    <files>
                        <inputBaseDirectory>../../yosql-examples-common/src/main/yosql</inputBaseDirectory>
                        <!-- Converters named in front matter are read from source, and the one this
                             example uses is shared with the other examples that read the same SQL. -->
                        <sourceDirectory>../../yosql-examples-common/src/main/java</sourceDirectory>
                    </files>
                    <repositories>
                        <basePackageName>wtf.metio.yosql.example.maven.jdbc.persistence</basePackageName>
                        <generateInterfaces>true</generateInterfaces>
                    </repositories>
                </configuration>
                <executions>
                    <execution>
                        <!-- Every configuration group, set to something other than its default,
                             through the mojo parameters the meta-model generates. The run above
                             sets two of the seven, and the other three frontends each carry the
                             same check of their own surface — this is the Maven one.

                             Its own output directory, because the generator clears what it wrote
                             before writing again — two executions sharing one would leave whichever
                             went second. -->
                        <id>config-surface</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <files>
                                <inputBaseDirectory>src/main/yosql-config</inputBaseDirectory>
                                <outputBaseDirectory>${project.build.directory}/generated-sources/config</outputBaseDirectory>
                                <sourceDirectory>src/main/java</sourceDirectory>
                                <sqlFilesSuffix>.sql</sqlFilesSuffix>
                            </files>
                            <repositories>
                                <basePackageName>wtf.metio.yosql.example.maven.jdbc.config.persistence</basePackageName>
                                <!-- Said again, because a plugin-level setting merges into every
                                     execution: without this the run inherits the interfaces the
                                     example above asks for, and the interface for these statements
                                     is named after their directory — the same name as the record
                                     they build. What this run generates should be what it declares. -->
                                <generateInterfaces>false</generateInterfaces>
                            </repositories>
                            <converter>
                                <recordConverterPrefix>Build</recordConverterPrefix>
                                <recordConverterSuffix>Mapper</recordConverterSuffix>
                                <recordConverterMethod>asRecord</recordConverterMethod>
                            </converter>
                            <!-- The DDL sits outside the statements, so only this can have found it;
                                 and its jsonb column resolves only for a declared vendor, so a
                                 vendor that fails to arrive stops the build rather than quietly
                                 generating something else. -->
                            <schema>
                                <sqlStatementsDirectory>src/main/schema</sqlStatementsDirectory>
                                <vendor>PostgreSQL</vendor>
                                <validation>ERROR</validation>
                            </schema>
                            <annotations>
                                <repositoryAnnotations>
                                    <repositoryAnnotation>
                                        <type>java.lang.SuppressWarnings</type>
                                        <members>
                                            <member>
                                                <key>value</key>
                                                <value>maven-config-example</value>
                                            </member>
                                        </members>
                                    </repositoryAnnotation>
                                </repositoryAnnotations>
                            </annotations>
                            <logging>
                                <api>JUL</api>
                            </logging>
                            <resources>
                                <maxThreads>1</maxThreads>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-config-surface-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/config</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>wtf.metio.yosql.example.maven.jdbc.ExampleApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
