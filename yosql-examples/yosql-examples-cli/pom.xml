<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ordering follows https://maven.apache.org/developers/conventions/code.html#POM_Code_Convention -->

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                                 PARENT                                  -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Inheritance -->
    <parent>
        <groupId>wtf.metio.yosql.examples</groupId>
        <artifactId>yosql-examples</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               COORDINATES                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Maven_Coordinates -->

    <groupId>wtf.metio.yosql.examples.cli</groupId>
    <artifactId>yosql-examples-cli</artifactId>
    <packaging>jar</packaging>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               INFORMATION                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#More_Project_Information -->
    <name>YoSQL :: Examples :: CLI</name>

    <dependencies>
        <dependency>
            <groupId>wtf.metio.yosql.tooling</groupId>
            <artifactId>yosql-tooling-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>wtf.metio.yosql.examples</groupId>
            <artifactId>yosql-examples-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>first</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <!-- exec rather than java: the CLI ends with System.exit, and the
                                 java goal runs it inside Maven's own JVM, where that would take
                                 Maven down with it. A forked process reports the same failure as
                                 a non-zero exit, which is what fails this build. -->
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>wtf.metio.yosql.tooling.cli.YoSQL</argument>
                                <argument>generate</argument>
                                <argument>--files-input-base-directory</argument>
                                <argument>${project.basedir}/../yosql-examples-common/src/main/yosql</argument>
                                <argument>--files-output-base-directory</argument>
                                <argument>${project.build.directory}/generated-sources/plain</argument>
                                <argument>--files-source-directory</argument>
                                <argument>${project.basedir}/../yosql-examples-common/src/main/java</argument>
                                <argument>--repositories-base-package-name</argument>
                                <argument>wtf.metio.yosql.example.cli.persistence</argument>
                                <argument>--converter-map-converter-class</argument>
                                <argument>wtf.metio.yosql.example.cli.converter.ToMapConverter</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>second</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <!-- exec rather than java: the CLI ends with System.exit, and the
                                 java goal runs it inside Maven's own JVM, where that would take
                                 Maven down with it. A forked process reports the same failure as
                                 a non-zero exit, which is what fails this build. -->
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>wtf.metio.yosql.tooling.cli.YoSQL</argument>
                                <argument>generate</argument>
                                <argument>--files-input-base-directory</argument>
                                <argument>${project.basedir}/../yosql-examples-common/src/main/yosql</argument>
                                <argument>--files-output-base-directory</argument>
                                <argument>${project.build.directory}/generated-sources/interfaces</argument>
                                <argument>--files-source-directory</argument>
                                <argument>${project.basedir}/../yosql-examples-common/src/main/java</argument>
                                <argument>--repositories-base-package-name</argument>
                                <argument>wtf.metio.yosql.example.cli.interfaces</argument>
                                <argument>--repositories-generate-interfaces</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Every configuration group, set to something other than its default,
                             through the options the meta-model generates for picocli. Each frontend
                             gets its own surface and its own wiring, so a group that arrives through
                             the mojo says nothing about the same group arriving on a command line.
                             The two runs above set three of the seven between them.

                             Its own output directory, because the generator clears what it wrote
                             before writing again — two runs sharing one would leave whichever went
                             second. -->
                        <id>config-surface</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-sources</phase>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>wtf.metio.yosql.tooling.cli.YoSQL</argument>
                                <argument>generate</argument>
                                <argument>--files-input-base-directory</argument>
                                <argument>${project.basedir}/src/main/yosql-config</argument>
                                <argument>--files-output-base-directory</argument>
                                <argument>${project.build.directory}/generated-sources/config</argument>
                                <argument>--files-source-directory</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>--files-sql-files-suffix</argument>
                                <argument>.sql</argument>
                                <argument>--repositories-base-package-name</argument>
                                <argument>wtf.metio.yosql.example.cli.config.persistence</argument>
                                <argument>--converter-record-converter-prefix</argument>
                                <argument>Build</argument>
                                <argument>--converter-record-converter-suffix</argument>
                                <argument>Mapper</argument>
                                <argument>--converter-record-converter-method</argument>
                                <argument>asRecord</argument>
                                <!-- The DDL sits outside the statements, so only this can have found
                                     it; and its jsonb column resolves only for a declared vendor, so
                                     a vendor that fails to arrive stops the build rather than
                                     quietly generating something else. -->
                                <argument>--schema-sql-statements-directory</argument>
                                <argument>${project.basedir}/src/main/schema</argument>
                                <argument>--schema-vendor</argument>
                                <argument>PostgreSQL</argument>
                                <argument>--schema-validation</argument>
                                <argument>ERROR</argument>
                                <!-- One string carrying a type and a member, which is how a command
                                     line spells what the other frontends spell as nested elements. -->
                                <argument>--annotations-repository-annotations</argument>
                                <argument>java.lang.SuppressWarnings:value|cli-config-example</argument>
                                <argument>--logging-api</argument>
                                <argument>JUL</argument>
                                <argument>--resources-max-threads</argument>
                                <argument>1</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-generated-code</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>wtf.metio.yosql.example.cli.ExampleApp</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <!-- Both runs are compiled. The second exists to exercise generated
                                 interfaces, and generating code nothing compiles proves only that
                                 the CLI exits zero. -->
                            <sources>
                                <source>${project.build.directory}/generated-sources/plain</source>
                                <source>${project.build.directory}/generated-sources/interfaces</source>
                                <source>${project.build.directory}/generated-sources/config</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
