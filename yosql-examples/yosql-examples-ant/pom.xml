<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ordering follows https://maven.apache.org/developers/conventions/code.html#POM_Code_Convention -->

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                                 PARENT                                  -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Inheritance -->
    <parent>
        <groupId>wtf.metio.yosql.examples</groupId>
        <artifactId>yosql-examples</artifactId>
        <version>0.0.0-SNAPSHOT</version>
    </parent>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               COORDINATES                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#Maven_Coordinates -->

    <groupId>wtf.metio.yosql.examples.ant</groupId>
    <artifactId>yosql-examples-ant</artifactId>
    <packaging>jar</packaging>

    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!--                               INFORMATION                               -->
    <!-- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->
    <!-- https://maven.apache.org/pom.html#More_Project_Information -->
    <name>YoSQL :: Examples :: Ant</name>

    <dependencies>
        <dependency>
            <groupId>wtf.metio.yosql.tooling</groupId>
            <artifactId>yosql-tooling-ant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>wtf.metio.yosql.examples</groupId>
            <artifactId>yosql-examples-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="runtime_classpath" refid="maven.runtime.classpath"/>

                                <taskdef name="yosql"
                                         classname="wtf.metio.yosql.tooling.ant.YoSQLGenerateTask"
                                         classpath="${runtime_classpath}"/>

                                <yosql>
                                    <files inputBaseDirectory="../yosql-examples-common/src/main/yosql"
                                           outputBaseDirectory="${project.build.directory}/generated-sources/yosql"
                                           sourceDirectory="../yosql-examples-common/src/main/java"/>
                                    <repositories basePackageName="wtf.metio.yosql.example.ant.persistence"
                                                  generateInterfaces="true"/>
                                </yosql>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Every configuration group, set to something other than its default,
                             through the elements and attributes the meta-model generates for Ant.
                             Each frontend gets its own surface and its own wiring, so a group that
                             arrives through the mojo says nothing about the same group arriving
                             through the task. The run above sets two of the seven.

                             Its own output directory, because the generator clears what it wrote
                             before writing again — two runs sharing one directory would leave
                             whichever went second. -->
                        <id>generate-config-surface</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="runtime_classpath" refid="maven.runtime.classpath"/>

                                <taskdef name="yosql"
                                         classname="wtf.metio.yosql.tooling.ant.YoSQLGenerateTask"
                                         classpath="${runtime_classpath}"/>

                                <yosql>
                                    <files inputBaseDirectory="src/main/yosql-config"
                                           outputBaseDirectory="${project.build.directory}/generated-sources/yosql-config"
                                           sourceDirectory="src/main/java"
                                           sqlFilesSuffix=".sql"/>
                                    <repositories basePackageName="wtf.metio.yosql.example.ant.config.persistence"/>
                                    <converter recordConverterPrefix="Build"
                                               recordConverterSuffix="Mapper"
                                               recordConverterMethod="asRecord"/>
                                    <!-- The DDL sits outside the statements, so only this can have
                                         found it; and its jsonb column resolves only for a declared
                                         vendor, so a vendor that fails to arrive stops the build
                                         rather than quietly generating something else. -->
                                    <schema sqlStatementsDirectory="src/main/schema"
                                            vendor="PostgreSQL"
                                            validation="ERROR"/>
                                    <annotations>
                                        <repositoryAnnotations type="java.lang.SuppressWarnings">
                                            <member key="value" value="ant-config-example"/>
                                        </repositoryAnnotations>
                                    </annotations>
                                    <logging api="JUL"/>
                                    <resources maxThreads="1"/>
                                </yosql>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/yosql</source>
                                <source>${project.build.directory}/generated-sources/yosql-config</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generating proves the Ant task runs. Running what it generated is what proves the
                 code it wrote works, and it is the same assertions every other frontend is held
                 to. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-generated-code</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>wtf.metio.yosql.example.ant.ExampleApp</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
