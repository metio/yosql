&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nt"&gt;&amp;lt;version&amp;gt;&lt;/span&gt;1.21.3&lt;span class="nt"&gt;&amp;lt;/version&amp;gt;&lt;/span&gt;
